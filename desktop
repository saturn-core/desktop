FROM ghcr.io/saturn-core/stable

RUN apt-get update && apt-get dist-upgrade -y && rm -rf /var/lib/apt/lists/* /var/log/{alternatives.log,apt/history.log,apt/term.log,dpkg.log}
RUN apt-get update && apt-get install -y ubuntu-minimal ubuntu-standard ubuntu-desktop-minimal && rm -rf /var/lib/apt/lists/* /var/log/{alternatives.log,apt/history.log,apt/term.log,dpkg.log}

RUN mkdir -p /var/lib/snapd/seed

COPY seed /var/lib/snapd/seed/